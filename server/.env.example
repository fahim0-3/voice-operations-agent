# Copy this file to `.env` and adjust as needed. Never commit the real .env.

# --- LLM provider selection ---
# One of: bedrock | ollama | openai
# Swap backends by changing this single line - no code changes needed.
LLM_PROVIDER=bedrock

# --- AWS Bedrock (used when LLM_PROVIDER=bedrock) ---
# Credentials are NOT set here - boto3 reads them from ~/.aws/credentials,
# environment variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY), or an
# IAM role, in that order. Run `aws configure` once if you haven't already.
BEDROCK_REGION=us-east-1
# Default: fastest verified TTFT (~500ms) - matters a lot for a voice agent.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Other verified-working model IDs you can swap in (benchmarked TTFT in
# comments - all measured via converse_stream on this project's account):
#   amazon.nova-lite-v1:0                                  (fast, cheap)
#   amazon.nova-micro-v1:0                                 (fastest, least capable)
#   us.anthropic.claude-haiku-4-5-20251001-v1:0             (~1.7s TTFT, smarter)
#   us.anthropic.claude-opus-4-5-20251101-v1:0              (~1.3s TTFT, very smart)
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0            (~1.9s TTFT, very smart)
#   us.anthropic.claude-sonnet-5                            (~1.7s TTFT, best coding/reasoning)
#   us.anthropic.claude-opus-5                              (~1.3s TTFT, best overall)
# Note the "us." prefix - the newest models are only invocable via a
# cross-region inference profile ID, not the bare model ID.

# --- Ollama (used when LLM_PROVIDER=ollama; fully local, no API costs) ---
OLLAMA_HOST=http://localhost:11434

OLLAMA_MODEL=qwen2.5:7b-instruct

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override to point at any OpenAI-compatible endpoint (Groq, Together, a
# local llama.cpp server with an OpenAI shim, etc) instead of api.openai.com:
OPENAI_BASE_URL=

# --- STT (faster-whisper) ---
STT_MODEL=distil-small.en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
# Where HF model weights are cached (keep off C: on Windows)
HF_HOME=D:/models/hf

# --- TTS (Piper) ---
TTS_VOICE=en_US-lessac-medium
TTS_MODELS_DIR=./assets/voices

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Agent persona and local audit ---
AGENT_NAME=Voice Operations Agent
WAKE_WORD_ENABLED=false
AUDIT_LOG_PATH=./data/operations-audit.jsonl
